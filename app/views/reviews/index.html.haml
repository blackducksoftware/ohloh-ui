#reviews_index
  - if @project
    - content_for(:html_title) { t('.title') }
    .settings-page-header
      .settings-page-header-row
        .settings-page-icon
          %i.fa.fa-star
        %h2.settings-page-h2
          = link_to t('reviews.rating_and_reviews'), summary_project_reviews_path(@project)
          = ' : '
          = t('.listing')
  - else
    - content_for(:html_title) { t('.account_title', name: @account.name) }
    .settings-page-header
      .settings-page-header-row
        .settings-page-icon
          %i.fa.fa-star
        %h2.settings-page-h2= t('reviews.reviews_and_ratings')
  - if @reviews.present?
    = render partial: 'shared/search_dingus', locals: { collection: @reviews, sort_context: :reviews,
      no_match_found_type: :flash }
    .reviews-list-container
      = render partial: 'review_list', collection: @reviews
    = render 'shared/modern_pagination', collection: @reviews
  - else
    .oh-review-card
      .oh-review-card__body
        .reviews-empty-state
          %span.reviews-empty-icon
            %i.fa.fa-star-o
          %p.reviews-empty-text= t('.no_reviews_yet')
