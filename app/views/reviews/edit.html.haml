- content_for(:html_title) { t('.title') }

.settings-page-header
  .settings-page-header-row
    .settings-page-icon
      %i.fa.fa-star
    %h2.settings-page-h2
      = link_to t('reviews.rating_and_reviews'), summary_project_reviews_path(@project)
      = t('edit')
  %p.settings-page-description= t('.page_description')

.oh-card
  = form_for([@project, @review]) do |f|
    = render partial: 'fields', locals: { f: f }
