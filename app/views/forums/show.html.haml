- content_for :html_title do
  = t('openhub_show', name: @forum.name.to_s)

.forum-page-wrap
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-comments
      %h2.settings-page-h2= @forum.name
      = link_to new_forum_topic_path(@forum), class: 'forum-btn forum-btn-primary forum-btn-sm' do
        %i.fa.fa-plus
        = t('.add_new_topic')
    %p.settings-page-description
      = link_to t('.forums'), forums_url
      %span.account-basics-sep ›
      = h(@forum.name)

  = render partial: '/forums/notice'

  .topics-list
    = render partial: 'topics/topic', collection: @topics

  = render 'shared/modern_pagination', collection: @topics
