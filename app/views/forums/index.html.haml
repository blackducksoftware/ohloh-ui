- content_for :html_title do
  = t('.openhub_forums')

.forum-page-wrap
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-comments
      %h2.settings-page-h2= t('.forums')

  = render partial: '/forums/notice'

  %p.forum-section-label= t('.active_topics')
  = render partial: '/topics/current_discussions', object: @recent_topics

  .forum-quick-links
    = link_to all_posts_path, class: 'forum-btn forum-btn-outline forum-btn-sm' do
      %i.fa.fa-clock-o
      = t('.recent_posts')
    = link_to all_posts_path(sort: :unanswered), class: 'forum-btn forum-btn-outline forum-btn-sm' do
      %i.fa.fa-question-circle
      = t('.unanswered_posts')

  %p.forum-section-label= t('.all_forums')
  .forum-list
    - @forums.each do |forum|
      .forum-card
        .forum-card-icon
          %i.fa.fa-comments
        .forum-card-body
          %p.forum-card-name= link_to h(forum.name), forum_path(forum)
          %p.forum-card-desc= forum.description
          .forum-card-meta
            %span.forum-card-stat
              %i.fa.fa-list
              = forum.topics_count
              = t('.topics')
            %span.forum-card-stat
              %i.fa.fa-comment
              = forum.posts_count
              = t('.posts')

  - if current_user_is_admin?
    .forum-index-actions
      = link_to t('.new_forum'), new_forum_path, class: 'forum-btn forum-btn-primary'
