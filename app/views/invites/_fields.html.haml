.invite-field
  %label.required.invite-label{ for: 'invite_invitee_email' } To
  .invite-input-wrapper
    %i.fa.fa-envelope-o.invite-input-icon
    = f.text_field :invitee_email, type: 'email', class: 'invite-input', placeholder: 'you@example.com'
  - error_tag @invite, :invitee_email
  - error_tag @invite, :send_limit
  %p.invite-help
    This email will be used only to send this invitation, and won't be stored or shared.

.invite-field
  %label.required.invite-label Subject
  %input.invite-input.invite-input--disabled{ type: 'text', disabled: 'disabled',
    value: t('.email_subject', name: @invite.invitor.name) }

.invite-field
  %label.required.invite-label Message
  .invite-message-preview
    = t('.email_body_html', invitor_name: 'Niharika', invitee_name: obfuscate_email('charlie.demo@example.com'),
        url: @invite.claim_url, project: 'Openhub Demo Project')

.invite-actions
  %input.invite-submit-btn{ type: 'submit', value: 'Send Invitation' }
