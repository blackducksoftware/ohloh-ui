- content_for(:html_title) { t('.page_title') }

.invite-page
  .invite-page-header
    %h1.invite-page-heading Invite User
    %p.invite-page-subheading= t('.invite_to_join', email: h(obfuscate_email(@invite.name.name)))

  .oh-card.invite-card
    = form_for(@invite, url: contributor_invites_path(@contribution), html: { method: :post, class: 'invite-form' }) do |f|
      = render partial: 'fields', locals: { f: f }
