- content_for(:html_title) do
  - t('.edit_privacy_title', account: @account.name)
- page_context[:select_footer_nav] = :settings

- account_context

#privacy-edit
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-shield
      %h2.settings-page-h2
        = link_to t('.settings'), settings_account_path(@account)
        %span.account-basics-sep :
        = t('privacy.privacy_text.privacy')
    %p.settings-page-description= t('accounts.settings.email_settings')

  .privacy-edit-grid
    .privacy-edit-col
      = form_for(@account, url: account_privacy_account_path) do |f|
        .edit-section
          .edit-section-header
            .edit-section-icon
              %i.fa.fa-envelope
            %h3.edit-section-title= t('.manage_email')

          .privacy-email-block
            %h4.privacy-block-title= t('.administrative_email')
            %p.edit-field-hint= t('.send_admin_email')

          .privacy-email-block
            %h4.privacy-block-title= t('.other_openhub_email')
            %p.edit-field-hint= t('.admin_email_notice')

            .privacy-radio-group
              .privacy-radio-option
                = f.radio_button :email_master, 'false', id: 'account_email_master_false', class: 'privacy-radio'
                = f.label :email_master, t('.dont_send_email'), value: 'false', class: 'privacy-radio-label'
              .privacy-radio-option
                = f.radio_button :email_master, 'true', id: 'account_email_master_true', class: 'privacy-radio'
                = f.label :email_master, t('.do_send_email'), value: 'true', class: 'privacy-radio-label'

            .privacy-email-prefs
              .privacy-pref-row
                = f.label :email_kudos, t('.notices_ive_received'), class: 'sr-only'
                %span.privacy-pref-please= t('.please')
                = f.select :email_kudos, [['include', true], ['exclude', false]], {}, class: 'privacy-select value-select'
                %span.privacy-pref-text= t('.notices_ive_received')
              .privacy-pref-row
                = f.label :email_posts, t('.replies_to_forum_topics'), class: 'sr-only'
                %span.privacy-pref-please= t('.please')
                = f.select :email_posts, [['include', true], ['exclude', false]], {}, class: 'privacy-select value-select'
                %span.privacy-pref-text= t('.replies_to_forum_topics')

            %p.edit-field-hint= t('.never_ask_for_personal_email')

          .edit-form-actions
            = submit_tag t('.save_changes'), id: 'Submit', class: 'edit-save-btn'

    .privacy-edit-col
      = render partial: 'authorized_apps'

  = render partial: 'privacy_text'

