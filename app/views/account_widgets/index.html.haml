- page_context[:select_footer_nav] = :widgets

- content_for(:html_title) { t('.page_title', who: @account.name) }

#account-widgets-index
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-puzzle-piece
      %h2.settings-page-h2
        = t('.widgets')
    %p.settings-page-description= t('.embed')

  = render partial: 'widget', collection: @widgets

  %p.widget-footer-note= t('.asks')
