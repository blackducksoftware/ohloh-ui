:ruby
  locals = { widget: widget, ref: 'sample' }
  widget_html = render(template: "#{controller_name}/#{widget.name.underscore}", locals: locals)

.widget-card
  .widget-card-header
    .widget-card-icon
      %i.fa.fa-code
    %h3.widget-card-title= widget.short_nice_name

  .widget-card-body
    .widget-preview
      .widget-preview-inner
        = widget_html

    .widget-embed-codes
      .widget-code-block
        %h5.widget-code-label HTML
        %p.widget-code-desc= t('.embed')
        %pre.widget-pre= CGI.unescapeHTML(CGI.escapeHTML(widget_html))

      .widget-code-block
        %h5.widget-code-label= t('.bbc_code')
        %p.widget-code-desc= t('.bbc')
        %pre.widget-pre= h render(template: "#{controller_name}/#{widget.name.underscore}", locals: locals.merge(bbc: true))
