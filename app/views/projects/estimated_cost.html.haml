:ruby
  content_for(:html_title) { t('.page_title', name: @project.name) }
  page_context[:select_top_menu_nav] = 'select_projects'
  page_context[:select_footer_nav] = :estimated_cost
  analysis = @project.best_analysis
  man_years = {}
  man_years[:logic_man_years] = analysis.man_years_from_loc(analysis.logic_total)
  man_years[:markup_man_years] = analysis.man_years_from_loc(analysis.markup_total)
  man_years[:build_man_years] = analysis.man_years_from_loc(analysis.build_total)
  cocomo_link = link_to(t('.basic_cocomo_model'), 'http://en.wikipedia.org/wiki/COCOMO', target: '_blank', rel: 'noopener noreferrer')

.cocomo-page
  .cocomo-page-header
    .cocomo-page-heading-row
      .cocomo-page-heading-icon
        %i.fa.fa-dollar
      %h1.cocomo-page-heading= t('.estimated_cost')

  - if !analysis.empty?
    - js = "var project_analysis = #{man_years.to_json};"
    %script{ type: 'text/javascript' }
      \ //<![CDATA[
      \ #{js.html_safe}
      \ //]]>

    .cocomo-main-grid
      .oh-card.cocomo-calculator-card
        .cocomo-card-header
          %i.fa.fa-calculator.cocomo-card-icon
          %h2.cocomo-card-title= t('.project_cost_calculator')

        .cocomo-card-body
          .cocomo-field-group
            %label.cocomo-label{ for: 'cocomo_loc_dropdown' }= t('.include')
            .cocomo-select-wrapper
              %select.chzn-select.value-select#cocomo_loc_dropdown{ 'aria-label': t('.include') }
                %option.selected{ value: analysis.code_total + analysis.markup_total + analysis.build_total }
                  = t('.all_code')
                %option{ value: analysis.logic_total }= t('.logic_code_only')
                %option{ value: analysis.markup_total }= t('.markup_only')
                %option{ value: analysis.build_total }= t('.build_scripts_only')

          .cocomo-field-group
            %label.cocomo-label{ for: 'cocomo_salary' }= t('.average_salary')
            .cocomo-input-group
              %span.cocomo-input-addon $
              %input.cocomo-input#cocomo_salary{ type: 'text', value: Analysis::AVG_SALARY, 'aria-label': t('.average_salary') }
              %span.cocomo-input-addon .00

          .cocomo-metrics-row
            .cocomo-metric
              %span.cocomo-metric-label= t('.codebase_size')
              .cocomo-metric-value
                %span#cocomo_loc= number_with_delimiter(analysis.code_total)
                %span.cocomo-metric-unit= t('.lines')
            .cocomo-metric
              %span.cocomo-metric-label= t('.estimated_effort')
              .cocomo-metric-value
                %span#cocomo_years= analysis.man_years.round
                %span.cocomo-metric-unit= t('.person_years')

          .cocomo-cost-result
            %span.cocomo-cost-label= t('.estimated_cost')
            .cocomo-cost-value
              %span.cocomo-cost-currency $
              %span#cocomo_value= number_with_delimiter((analysis.man_years * Analysis::AVG_SALARY).round)

        .cocomo-card-footer
          %span.cocomo-footnote
            *
            = t('.basic_cocomo_model').then { |label| link_to label, 'http://en.wikipedia.org/wiki/COCOMO', target: '_blank', rel: 'noopener noreferrer', class: 'cocomo-footnote-link' }

      .oh-card.cocomo-help-card
        .cocomo-card-header
          %i.fa.fa-question-circle.cocomo-card-icon
          %h2.cocomo-card-title= t('.too_high')

        .cocomo-card-body
          %p.cocomo-help-text!= t('.help1')
          - code_location_link = link_to t('.code_locations'), project_enlistments_path(@project)
          %p.cocomo-help-text!= t('.help2', link: code_location_link)
          %ul.cocomo-help-list
            %li= t('.help3')
            %li= t('.help4')

    .about-account-basics-card
      .card-header
        .card-header-left
          .card-header-icon
            %i.fa.fa-calculator
          .card-header-text
            %h4.card-title= t('.about') + ' ' + t('.cost_estimates')
        %button.expand-toggle{ type: 'button', 'aria-label' => 'Toggle about section' }
          %i.fa.fa-chevron-down

      .card-content
        .tips-grid
          .tip-item
            .tip-icon
              %i.fa.fa-question-circle
            .tip-body
              %p.tip-text= t('.tip_estimation')
          .tip-item
            .tip-icon
              %i.fa.fa-cogs
            .tip-body
              %p.tip-text!= t('.tip_model_html', link: cocomo_link)
          .tip-item
            .tip-icon
              %i.fa.fa-building
            .tip-body
              %p.tip-text= t('.tip_caveat')
          .tip-item
            .tip-icon
              %i.fa.fa-line-chart
            .tip-body
              %p.tip-text= t('.tip_maturity')

  - else
    = render partial: 'projects/show/no_analysis_summary'

