:ruby
  @project ||= Project.new
  content_for(:html_title) { t('.page_title', name: @project.name.blank? ? 'New Project' : @project.name) }
  page_context[:select_top_menu_nav] = 'select_projects'

#project-edit-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-plus-circle
      %h2.settings-page-h2
        = t('projects.new.call_to_action')

  = form_for @project, as: :project, url: projects_path, html: { class: 'styled new_project', id: 'new_project' } do |f|
    .edit-form-grid
      .edit-form-col

        .edit-section
          .edit-section-header
            .edit-section-icon
              %i.fa.fa-id-card
            %h3.edit-section-title= t('.create_a_new_project')

          .edit-field-group
            %label.edit-field-label.required{ for: 'project_name' }= t('.project_name')
            .edit-field-input-wrapper
              %i.fa.fa-pencil.edit-field-icon
              = text_field_tag 'project[name]', @project.name, class: 'edit-field-input', id: 'project_name'
            - error_tag @project, :name
            %p.edit-field-hint!= t('.project_name_help', link: link_to(t('.contact_us'), blog_url_for(:contact_form)))

          .edit-field-group
            %label.edit-field-label.required{ for: 'repository_type' }= t('.project_source_code')
            .source-code-fields
              = select_tag :scm_type, scm_options_for_select(@project.code_location_object&.scm_type),
                name: 'project[enlistments_attributes][0][code_location_attributes][scm_type]',
                class: 'chzn-select value-select form-control', id: 'repository_type'
              .edit-field-group
                %label.edit-field-label{ for: 'url' }= t('.repository_url')
                .edit-field-input-wrapper
                  %i.fa.fa-link.edit-field-icon
                  = text_field_tag :url, @project.code_location_object&.url,
                    class: 'edit-field-input',
                    name: 'project[enlistments_attributes][0][code_location_attributes][url]'
              .edit-field-group
                %label.edit-field-label{ for: 'branch' }= t('.branch')
                .edit-field-input-wrapper
                  %i.fa.fa-code-fork.edit-field-icon
                  = text_field_tag :branch, @project.code_location_object&.branch || 'main',
                    class: 'edit-field-input',
                    name: 'project[enlistments_attributes][0][code_location_attributes][branch]'
            - error_tag @project, 'enlistments.base'

          .edit-field-group
            .edit-field-checkbox-wrapper
              = f.check_box :managed_by_creator, id: 'project_managed_by_creator', class: 'edit-field-checkbox'
              %label.edit-field-checkbox-label{ for: 'project_managed_by_creator' }= t('.i_manage_this_project')
            %p.edit-field-hint
              = t('.i_manage_this_project_help1')
              %br
              = t('.i_manage_this_project_help2')

        .edit-section
          .edit-section-header
            .edit-section-icon
              %i.fa.fa-link
            %h3.edit-section-title Project URL

          .edit-field-group
            %label.edit-field-label.required{ for: 'project_vanity_url' }= t('.url')
            .edit-field-input-wrapper.project-url-prepend
              %span.edit-field-prefix http://www.openhub.net/p/
              = f.text_field :vanity_url, class: 'edit-field-input check-availability', autocomplete: 'off',
                                          'data-original-value' => Project.find_by(id: @project).try(:vanity_url),
                                          'data-ajax-path' => project_check_availabilities_path,
                                          'data-preview-base-url' => projects_url
            = render 'shared/availability_preview'
            - error_tag @project, :vanity_url, class: 'error vanity_url'
            %p.edit-field-hint
              = t('.url_help1')
              %br
              = t('.url_help2')

          .edit-field-group
            %label.edit-field-label{ for: 'project_description' }= t('.description')
            = find_and_preserve(f.text_area(:description, max_length: 800, class: 'edit-field-input edit-field-textarea'))
            - error_tag @project, :description
            %p.edit-field-hint
              = t('.description_help1')
              %br
              = t('.description_help2')

      / ── Right column ──────────────────────────────────────
      .edit-form-col

        .edit-section
          .edit-section-header
            .edit-section-icon
              %i.fa.fa-globe
            %h3.edit-section-title Project Links

          .edit-field-group
            %label.edit-field-label{ for: 'project_url' }= t('.homepage_page')
            .edit-field-input-wrapper
              %i.fa.fa-home.edit-field-icon
              = f.text_field :url, class: 'edit-field-input'
            - error_tag @project, :url
            %p.edit-field-hint= t('.homepage_page_help')

          .edit-field-group
            %label.edit-field-label{ for: 'project_download_url' }= t('.download_page')
            .edit-field-input-wrapper
              %i.fa.fa-download.edit-field-icon
              = f.text_field :download_url, class: 'edit-field-input'
            - error_tag @project, :download_url
            %p.edit-field-hint= t('.download_page_help')

        .edit-section
          .edit-section-header
            .edit-section-icon
              %i.fa.fa-legal
            %h3.edit-section-title Licensing

          .edit-field-group
            %label.edit-field-label{ for: 'add_license' }= t('.add_license')
            .edit-field-input-wrapper
              %i.fa.fa-certificate.edit-field-icon
              %input.license.edit-field-input#add_license{ type: 'text' }
            %p.edit-field-hint
              = t('.add_license_help1')
              %br
              = t('.add_license_help2')

          .edit-field-group
            %label.edit-field-label= t('.chosen_licenses')
            .chosen_licenses
              .no-license.inset= t('.none')
              .license-cell.license-template
                .license_name
                .license-remove-btn-wrap
                  %a.btn.btn-danger.btn-mini.remove_license{ href: 'javascript:' }
                    %i.icon-trash>
                    = t('.remove')

    .enl-form-actions
      %input.edit-save-btn{ type: 'submit', value: t('.submit'), 'data-disable-with' => t('.processing') }


