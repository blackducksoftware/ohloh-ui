%h4.scan-card-title CWE Top 25 Defects
- if cwes.blank?
  %p.scan-empty-text No top 25 CWE defects were found.
- else
  .cwe-table-wrapper
    %table.cwe-table
      %thead
        %tr
          %th.col-right ID
          %th CWE Name
          %th.col-right Defects
      %tbody
        - cwes.each do |cwe|
          %tr
            %td.col-right= link_to cwe.id, cwe.uri, target: '_blank', rel: 'noopener noreferrer'
            %td= cwe.name
            %td.col-right= cwe.defect_count
