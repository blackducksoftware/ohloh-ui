:ruby
  scan_data = JSON.parse(scan_analytics.data, object_class: OpenStruct)
  metrics = scan_data.analysis_metrics

.scan-analytics-section
  .scan-analytics-header
    .scan-analytics-icon
      %i.fa.fa-shield
    .scan-analytics-heading
      .scan-title-row
        %h2.section-title
          = link_to 'Static Analysis', project_scan_analytics_path(@project, code_set_id: scan_analytics.code_set_id)
        %span.scan-coverity-badge
          %i.fa.fa-check-circle
          Coverity Scan
      .scan-analytics-meta
        %span.scan-meta-text
          Generated for
          = link_to scan_data.project, scan_data.project_url, target: '_blank', rel: 'noopener noreferrer'
        - url = scan_analytics.code_set&.code_location&.url
        - if url.present?
          %span.scan-meta-separator ·
          %span.scan-meta-text
            = url =~ /^http/ ? link_to(url, url, target: '_blank', rel: 'noopener noreferrer') : url

  .scan-analytics-grid
    .gradient-card
      .card-content
        .scan-card-header
          %h4.scan-card-title Version
          %span.scan-card-version= metrics.version.presence || 'N/A'

        .scan-metrics-group
          %p.scan-group-label Build Information
          .scan-metrics-row
            .scan-metric
              .scan-metric-value= metrics.build_date
              .scan-metric-label Last Analyzed
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.loc) || 'N/A'
              .scan-metric-label Lines of Code
            .scan-metric
              .scan-metric-value= metrics.defect_density&.score.to_f || 'N/A'
              .scan-metric-label Defect Density

        .scan-metrics-group
          %p.scan-group-label Defects by Status
          .scan-metrics-row
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.total_count) || '0'
              .scan-metric-label Total
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.outstanding_count) || '0'
              .scan-metric-label Outstanding
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.fixed_count) || '-'
              .scan-metric-label Fixed

    .gradient-card
      .card-content
        = render partial: 'projects/show/cwe', locals: { cwes: scan_data.cwe }

