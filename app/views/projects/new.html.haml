- content_for(:html_title) { t('.page_title') }
- page_context[:select_top_menu_nav] = 'select_projects'

- if ApiAccess.available?
  #project-new-page
    .settings-page-header
      .settings-page-header-row
        .settings-page-icon
          %i.fa.fa-plus-circle
        %h2.settings-page-h2
          = t('.call_to_action')

    .project-new-form-layout
      .oh-card
        = form_tag check_forge_projects_path, class: 'styled new_project' do
          %fieldset
            .project-new-help
              %p= t('.help1')
              %p.margin_bottom_0= t('.help2')

            .enl-form-row
              %label.enl-label{ for: 'codelocation' }= t('.codelocation_label')
              %input.form-control#codelocation{ name: 'codelocation', type: 'text',
                placeholder: 'https://github.com/owner/repo' }

            .project-new-examples
              %p.project-new-examples-label= t('.examples')
              .project-new-example-item
                %code!= t('.example1')
              .project-new-example-item
                %code!= t('.example2')

            .enl-form-actions.margin_top_10
              %input.edit-save-btn{ type: 'submit', value: t('.next') }
- else
  .padding_one_top
  = render 'shared/api_outage'
