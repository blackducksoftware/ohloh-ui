- similar_stacks = stack.similar_stacks(10)
- unless similar_stacks.blank?
  .edit-section.similar-stacks-card#similar_stacks
    .edit-section-header
      .edit-section-icon
        %i.fa.fa-users
      %h3.edit-section-title= t('.people_with_similar_stacks')
    .similar-stacks-avatars
      - similar_stacks.each do |s|
        = avatar_for s[:stack].account, size: 34, url: stack_path(s[:stack]), title: s[:stack].account.name
    %a.similar-stacks-more{ href: similar_stack_path(@stack) }
      = t('.more')
      %i.fa.fa-chevron-right
