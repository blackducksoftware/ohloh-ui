- hidden ||= false

%tr.stack_entry{ id: "stack_entry_#{stack_entry.id}", style: ('display:none;' if hidden) }
  %td.stack-entry-logo-cell
    - project_icon(stack_entry.project, :small)
  %td.stack-entry-body-cell
    %a.stack-entry-name{ href: project_url(stack_entry.project) }= h(stack_entry.project.name)
    - if stack_entry.project.rating_average
      .stack-entry-rating
        %span.stack-entry-rating-label= 'Community rating:'
        .rating_stars
          != rating_stars('average_rating_stars', stack_entry.project.rating_average.to_i, mini: true)
    .stack-entry-note
      %span.stack-entry-note-label= t(:notes, scope: 'stacks.stack_entry')
      - if editable
        - uri = "/stacks/#{@stack.id}/stack_entries/#{stack_entry.id}"
        %span.rest_in_place{ url: uri, object: 'stack_entry', attribute: 'note',
                             col: '32', rows: '7', max_length: StackEntry::MAX_NOTE_LENGTH }
          = stack_entry.note
        - stack_edit_in_place
      - else
        %span.stack-entry-note-text= stack_entry.note
  - if editable
    %td.stack-entry-action-cell
      %a.stack-entry-remove-btn.command.stack_remove{ href: '#', id: "stackit_#{stack_entry.project.vanity_url}" }
        %i.fa.fa-trash{ 'aria-hidden' => 'true' }
        = t(:remove, scope: 'stacks.stack_entry')
