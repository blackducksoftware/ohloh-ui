:ruby
  content_for(:html_title) { t('.page_title', name: @project.name) }
  page_context[:select_top_menu_nav] = 'select_projects'
  page_context[:select_footer_nav] = nil
  content_for :javascript do
    js = "document.addEventListener('DOMContentLoaded', function() { \
            $('#edit_project_license').submit(function(e) { \
              if($('.chzn-container-single a.chzn-single').text().trim() == '#{t('.select_placeholder')}') { \
                e.preventDefault(); \
                $('#error').show(); \
              } \
            }); \
          });"
    javascript_tag(js)
  end

= render partial: 'layouts/partials/alert'

#project-license-new-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-certificate
      %h2.settings-page-h2
        = link_to t(:settings), settings_project_path(@project)
        %span.account-basics-sep :
        = link_to t('.licenses'), project_licenses_path(@project)
        %span.account-basics-sep :
        = t(:new)
    %p.settings-page-description= t('.page_title', name: @project.name)

  .project-edit-layout
    .project-edit-main
      .oh-card
        .license-new-card-header
          %h3.license-new-card-title
            %i.fa.fa-plus-circle
            = t('.new_declared_license')

        #error{ style: 'display: none;' }
          .alert.alert-danger.license-alert
            %i.fa.fa-exclamation-circle
            = t('.at_least_one')

        = form_for ProjectLicense.new, url: project_licenses_path(@project),
                                       html: { class: 'edit_project license-new-form', id: 'edit_project_license' } do
          .license-field-group
            %label.license-field-label.required{ for: 'value_selector' }
              = t('.license')
            .license-select-wrap
              %select.chzn-select#value_selector{ name: 'license_id',
                                                               data: { placeholder: t('.select_placeholder') } }
                %option{ value: 'blank' }
                - @licenses.each do |license|
                  %option{ value: license.id }= license.name
            %p.license-help-text
              - link = link_to t('.add_it'), new_license_path
              != t('.add_it_help', link: link)
            - error_tag @license, :license_id

          .license-form-actions
            - if @project.edit_authorized?
              %button.btn.btn-primary.btn-add-license{ type: 'submit' }
                %i.fa.fa-plus
                = t('.add_declared_license')
              = link_to t('cancel'), project_licenses_path(@project), class: 'btn btn-default btn-cancel-license'
            - else
              = disabled_button t('.add_declared_license'), class: 'btn-primary add-license'

    .project-edit-aside
      = render partial: 'project_licenses/about'
