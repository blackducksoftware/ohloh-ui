- chart_url = commits_by_language_account_charts_url(@account, scope: 'full').to_s
- light_wm = asset_url('charts/watermark_860.png')
- dark_wm  = light_wm

.margin_top_10
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-code
      %h2.settings-page-h2= t('.title')
  .clearfix
  .pull-right.chosen.languages#sort_by
    %select.chzn-select.language_category#streamgraph_category
      %option{ value: '#' }= t('.sort_option.hash')
      %option{ value: '2' }= t('.sort_option.two')
      %option{ value: '1' }= t('.sort_option.one')
      %option{ value: '0' }= t('.sort_option.zero')
  .clearfix
.stream_graph.full.languages#ohloh_streamgraph{ 'datascope' => 'full', 'datasrc' => chart_url, 'data-light-watermark' => light_wm, 'data-dark-watermark' => dark_wm }
