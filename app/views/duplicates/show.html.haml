- content_for(:html_title) { t('.html_title') }

#duplicate-show-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-code-fork
      %h2.settings-page-h2
        = t('.title')

  .duplicate-show-summary.oh-card
    .duplicate-show-summary-text
      %span.duplicate-show-time
        %i.fa.fa-clock-o
        = time_ago_in_words(@duplicate.created_at)
        = t(:ago)
      = link_to(h(@duplicate.account.name), account_url(@duplicate.account), class: 'duplicate-show-account-link')
      = t('.reported_that')
      = link_to h(@duplicate.bad_project.name), project_path(@duplicate.bad_project), class: 'duplicate-show-project-link duplicate-show-project-link--bad'
      = t('.is_duplicate')
      = link_to h(@duplicate.good_project.name), project_path(@duplicate.good_project), class: 'duplicate-show-project-link duplicate-show-project-link--good'

  .duplicate-show-details
    .duplicate-show-detail-card.oh-card
      .duplicate-show-detail-header
        %i.fa.fa-user
      .duplicate-show-detail-body
        %h4.duplicate-show-detail-title= t('.reported_by')
        .duplicate-show-reporter
          = avatar_for(@duplicate.account, size: 32)
          = link_to(h(@duplicate.account.name), account_url(@duplicate.account), class: 'duplicate-show-reporter-name')

    .duplicate-show-detail-card.oh-card
      .duplicate-show-detail-header
        %i.fa.fa-comment
      .duplicate-show-detail-body
        %h4.duplicate-show-detail-title= t('.comment')
        %p.duplicate-show-comment= h(@duplicate.comment)

  .duplicate-show-comparison
    .duplicate-show-project-card.duplicate-show-project-card--good
      = render partial: 'project', locals: { project: @duplicate.good_project }
    .duplicate-show-project-card.duplicate-show-project-card--bad
      = render partial: 'project', locals: { project: @duplicate.bad_project }

  .duplicate-show-table.oh-card
    %table.duplicate-comparison-table
      %thead
        %tr
          %th.duplicate-table-label
            %span.sr-only Attribute
          %th.duplicate-table-good= t('.keep', project: h(truncate_project_name(@duplicate.good_project.name, link: true)))
          %th.duplicate-table-bad= t('.keep', project: h(truncate_project_name(@duplicate.bad_project.name, link: true)))
      %tbody
        %tr
          %td.duplicate-table-label= t('.created')
          %td.duplicate-table-good
            = time_ago_in_words(@duplicate.good_project.created_at) + t('.ago')
            = t('.by')
            - good_project_edit = CreateEdit.where(project_id: @duplicate.good_project.id).take
            = link_to h(good_project_edit.account.name), account_path(good_project_edit.account)
          %td.duplicate-table-bad
            = time_ago_in_words(@duplicate.bad_project.created_at) + t('.ago')
            = t('.by')
            - bad_project_edit = CreateEdit.where(project_id: @duplicate.bad_project.id).take
            = link_to h(bad_project_edit.account.name), account_path(bad_project_edit.account)
        %tr
          %td.duplicate-table-label= t('.url')
          %td.duplicate-table-good= link_to nil, project_path(@duplicate.good_project.vanity_url)
          %td.duplicate-table-bad= link_to nil, project_path(@duplicate.bad_project.vanity_url)
        %tr
          %td.duplicate-table-label= t('.homepage')
          %td.duplicate-table-good= link_to nil, @duplicate.good_project.url
          %td.duplicate-table-bad= link_to nil, @duplicate.bad_project.url
        %tr
          %td.duplicate-table-label= t('.users')
          %td.duplicate-table-good= pluralize(@duplicate.good_project.user_count, 'user')
          %td.duplicate-table-bad= pluralize(@duplicate.bad_project.user_count, 'user')
        %tr
          %td.duplicate-table-label= t('.ratings')
          %td.duplicate-table-good= pluralize(@duplicate.good_project.ratings.count, 'ratings')
          %td.duplicate-table-bad= pluralize(@duplicate.bad_project.ratings.count, 'ratings')
        %tr
          %td.duplicate-table-label= t('.last_analyzed')
          %td.duplicate-table-good
            - if @duplicate.good_project.best_analysis.oldest_code_set_time
              = time_ago_in_words(@duplicate.good_project.best_analysis.oldest_code_set_time) + t('.ago')
            - else
              = t('.never')
          %td.duplicate-table-bad
            - if @duplicate.bad_project.best_analysis.oldest_code_set_time
              = time_ago_in_words(@duplicate.bad_project.best_analysis.oldest_code_set_time) + t('.ago')
            - else
              = t('.never')
        %tr
          %td.duplicate-table-label= t('.enlistments')
          %td.duplicate-table-good
            = link_to pluralize(@duplicate.good_project.enlistments.count, 'repository'),
            project_enlistments_path(@duplicate.good_project),
            title: @duplicate.good_project.enlistments[0..20].map { |e| h(e.code_location.nice_url) }.join('\n')
          %td.duplicate-table-bad
            = link_to pluralize(@duplicate.bad_project.enlistments.count, 'repository'),
            project_enlistments_path(@duplicate.bad_project),
            title: @duplicate.bad_project.enlistments[0..20].map { |e| h(e.code_location.nice_url) }.join('\n')
        %tr.duplicate-table-suggestion-row
          %td.duplicate-table-label= t('.suggests')
          %td.duplicate-table-good
            %span.duplicate-suggest-badge
              %i.fa.fa-check
              = t('.user_wants')
          %td.duplicate-table-bad &nbsp;

  .duplicate-show-actions
    .duplicate-show-actions-row
      = link_to "/duplicates/#{@duplicate.id}/resolve/#{@duplicate.good_project.id}",
      method: :post, class: 'duplicate-action-btn duplicate-action-btn--keep',
      title: t('.keep_title', bad: @duplicate.good_project.name, good: @duplicate.bad_project.name),
      data: { confirm: t('.keep_confirm', bad: @duplicate.good_project.name, good: @duplicate.bad_project.name) } do
        %i.fa.fa-check-circle
        = t('.keep', project: h(truncate_project_name(@duplicate.good_project.name, link: true)))

      = link_to "/duplicates/#{@duplicate.id}/resolve/#{@duplicate.bad_project.id}",
      method: :post, class: 'duplicate-action-btn duplicate-action-btn--keep-alt',
      title: t('.keep_title', good: @duplicate.good_project.name, bad: @duplicate.bad_project.name),
      data: { confirm: t('.keep_confirm', good: @duplicate.good_project.name, bad: @duplicate.bad_project.name) } do
        %i.fa.fa-check-circle
        = t('.keep', project: h(truncate_project_name(@duplicate.bad_project.name, link: true)))

      = link_to project_duplicate_path(@duplicate.bad_project, @duplicate),
      method: :delete, data: { confirm: t('.confirm_close') },
      class: 'duplicate-action-btn duplicate-action-btn--close', title: t('.close_title') do
        %i.fa.fa-times-circle
        = t('.close_request')
