- good = @duplicate.good_project

.enl-form-row
  %label.enl-label.required{ for: 'good_project' }
    != t('.good_label_html', name: truncate_project_name(@duplicate.bad_project.name))
  .duplicate-search-group
    %span.duplicate-search-icon
      %i.fa.fa-search
    = text_field_tag :good_project, good.try(:name), id: 'good_project',
      class: 'form-control duplicate-search-input autocompletable',
      placeholder: t('.search_placeholder'),
      data: { source: '/autocompletes/project_duplicates', select: 'duplicatesSelect' }
    .hidden#new_duplicate_spinner
      %i.fa.fa-spinner.fa-spin.duplicate-spinner-icon
  - error_tag @duplicate, :good_project

.duplicate-selected-panel#good_project_url_label{ class: good ? '' : 'hidden' }
  %span.duplicate-selected-label= t('.original_url')
  %a.duplicate-url#good_project_url{ base: projects_url, href: good ? project_url(good) : '#' }
    %i.fa.fa-external-link
    = good ? project_url(good) : ''

.enl-form-row
  %label.enl-label{ for: 'duplicate_comment' }= t('.comment')
  = form.text_area(:comment, id: 'duplicate_comment', rows: 6, max_length: 1000, class: 'form-control duplicate-textarea')

= form.hidden_field :bad_project_id
= form.hidden_field :good_project_id

.enl-form-actions
  = form.submit button_text, class: 'edit-save-btn'
