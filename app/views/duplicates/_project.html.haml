.duplicate-project-detail{ id: "project_#{project.id}" }
  %h3.duplicate-project-detail-name= link_to h(truncate_project_name(project.name, link: true)), project_path(project), title: project.name
  - if project.description.present?
    %p.duplicate-project-detail-desc= expander(project.description, 300, 350)
  .duplicate-project-detail-stats
    .duplicate-project-detail-stat
      != rating_stars('average_rating_stars', project.rating_average || 0, mini: true)
      = link_to pluralize_with_delimiter(project.reviews.count, 'review'), project_reviews_path(project)
    .duplicate-project-detail-stat
      %i.fa.fa-users
      = pluralize_with_delimiter(project.user_count, 'user')
    - unless project.best_analysis.empty?
      .duplicate-project-detail-stat
        %i.fa.fa-code
        = link_to t('.lines_of_code', lines: pluralize_with_delimiter(project.best_analysis.code_total, 'line')),
        project_analysis_path(project, 'latest')
  - unless project.tag_list.empty?
    .duplicate-project-detail-tags
      %i.fa.fa-tags
      = tag_links(project.tag_list.split, 8)
      - if project.tag_list.split.size > 8
        = link_to "#{(project.tag_list.split.size - 8)}#{t('.more')}", project_tags_path(project), class: 'duplicate-tag-more'
