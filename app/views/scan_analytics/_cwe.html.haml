%h4.scan-card-title= t('.cwe_title')
- if cwes.blank?
  %p.scan-empty-text= t('.cwe_no_data')
- else
  .cwe-table-wrapper
    %table.cwe-table
      %thead
        %tr
          %th.col-right= t('.table_id')
          %th= t('.cwe_Name')
          %th.col-right= t('.no_of_defects')
      %tbody
        - cwes.each do |cwe|
          %tr
            %td.col-right= link_to cwe.id, cwe.uri, target: '_blank', rel: 'noopener noreferrer'
            %td= cwe.name
            %td.col-right= cwe.defect_count
