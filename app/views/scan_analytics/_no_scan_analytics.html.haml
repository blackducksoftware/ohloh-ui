.scan-analytics-section
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-shield
      %h2.settings-page-h2
        = link_to @project.name, project_path(@project)
        %span.account-basics-sep :
        = t('.page_title')

  .scan-empty-state
    %i.fa.fa-bar-chart.scan-empty-icon
    %p.scan-empty-message= t('.no_data')
