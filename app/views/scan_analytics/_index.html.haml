:ruby
  scan_data = JSON.parse(@scan_data.data, object_class: OpenStruct)
  metrics = scan_data.analysis_metrics

#scan_data.scan-analytics-section
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-shield
      %h2.settings-page-h2
        = t('.page_title')

  - if @analytics.size > 1
    .scan-enlistment-selector
      %span.scan-enlistment-count
        %i.fa.fa-code-fork
        = "1 of #{@analytics.size} enlistments"
      = select_tag :code_set_id,
          options_for_select(@analytics.collect { |u| [u.code_set.code_location.url, u.code_set_id] }, params[:code_set_id]),
          class: 'chzn-select value-select',
          data: { remote: true, url: project_scan_analytics_path(@project), method: 'get' }
      .overlay-loader
        = image_tag 'ui/loadingAnimation.gif', alt: t('loading'), class: 'loader'

  .scan-page-meta
    %span.scan-meta-text
      Generated by Coverity Scan for
      = link_to scan_data.project, scan_data.project_url, target: '_blank', rel: 'noopener noreferrer'

  .scan-analytics-grid
    .gradient-card
      .card-content
        .scan-card-header
          %h4.scan-card-title Version
          %span.scan-card-version= metrics.version.presence || 'N/A'

        .scan-metrics-group
          %p.scan-group-label Build Information
          .scan-metrics-row
            .scan-metric
              .scan-metric-value= metrics.build_date
              .scan-metric-label= t('.last_analyzed')
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.loc) || 'N/A'
              .scan-metric-label= t('.loc')
            .scan-metric
              .scan-metric-value= metrics.defect_density&.score.to_f || 'N/A'
              .scan-metric-label= t('.defect')

        .scan-metrics-group
          %p.scan-group-label Defects by Status
          .scan-metrics-row
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.total_count) || '0'
              .scan-metric-label= t('.total_defects')
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.outstanding_count) || '0'
              .scan-metric-label= t('.outstanding')
            .scan-metric
              .scan-metric-value= number_with_delimiter(metrics.fixed_count) || '-'
              .scan-metric-label= t('.fixed')

    .gradient-card
      .card-content
        = render partial: 'scan_analytics/cwe', locals: { cwes: scan_data.cwe }

  .scan-charts-section
    #chart_data{ 'data-project-id' => @project.vanity_url.to_s, 'data-code-set-id' => (params[:code_set_id] || @scan_data.code_set_id).to_s }
      #chart1
      #chart2
      #chart3
      #chart4
