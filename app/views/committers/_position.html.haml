- project = position.project
- name_fact = @name_facts_map[project.best_analysis_id]

.claim-position-card.oh-card
  .claim-position-card__tile
    = render 'unclaimed_tile', project: project, name_fact: name_fact
  .claim-position-card__fields
    %input{ type: 'hidden', value: project.id, name: 'positions[][project_id]' }
    .claim-position-field
      %label.claim-position-card__label
        %i.fa.fa-briefcase{ 'aria-hidden' => 'true' }
        = t('.your_role', name: project.name)
      .claim-position-input-wrapper
        %input.form-control{ placeholder: t('.your_role', name: project.name),
          type: 'text', name: 'positions[][title]', value: position.title }
    .claim-position-field
      %label.claim-position-card__label
        %i.fa.fa-align-left{ 'aria-hidden' => 'true' }
        = t('.description')
      %textarea.form-control{ placeholder: t('.description'),
        name: 'positions[][description]', rows: 3 }= position.description
    - if position.errors.present?
      .claim-position-card__error
        %i.fa.fa-exclamation-circle{ 'aria-hidden' => 'true' }
        = position.errors[:base]
