- content_for(:html_title) { html_title }
- page_context[:select_top_menu_nav] = :select_people

.committers-page-body
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-code-fork
      %h2.settings-page-h2
        = link_to t('.heading'), committers_path
        = ' : '
        = @name.name
    %p.settings-page-description= t('.people')

  = render 'people/unclaimed_person', name_id: @name.id, people: @people, from_show_page: true
