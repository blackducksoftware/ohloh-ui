- if logged_in?
  .reply-section
    .reply-section-header
      %i.fa.fa-reply
      %h4= t('.post_a_response')
    .reply-form-body
      = form_for @post, url: topic_posts_path(@topic) do |f|
        = hidden_field_tag :page, params[:page]
        = render partial: 'posts/fields', locals: { f: f }

- else
  .reply-login-prompt
    %i.fa.fa-lock{ style: 'margin-right: 6px' }
    = t('.post_a_response')
    = render 'posts/sign_in'
