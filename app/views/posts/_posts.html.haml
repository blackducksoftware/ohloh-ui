.account-post-item
  .account-post-main
    .account-post-breadcrumb
      = link_to h(posts.topic.forum.name), forum_path(posts.topic.forum)
      %i.fa.fa-chevron-right{ style: 'font-size: 9px' }
      = link_to h(posts.topic.title), topic_path(posts.topic)
    %p.account-post-excerpt= expander(strip_tags(markdown_format(posts.body)), 200, 250)
  .account-post-meta
    .account-post-views
      %i.fa.fa-eye
      = posts.topic.hits
    %span.account-post-date= t('.posted_ago', date: time_ago_in_words(posts.created_at))
