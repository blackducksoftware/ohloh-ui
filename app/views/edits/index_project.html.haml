:ruby
  content_for(:html_title) { t('.page_title', name: @parent.name) }
  page_context[:select_top_menu_nav] = 'select_projects'
  page_context[:select_footer_nav] = nil

%meta{ name: 'ROBOTS', content: 'NOINDEX, NOFOLLOW' }

#project-edit-history-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-history
      %h2.settings-page-h2
        = link_to t(:settings), settings_project_path(@parent)
        %span.account-basics-sep :
        = link_to h(truncate(@parent.name, length: 42)), project_path(@parent), title: @parent.name
        %span.account-basics-sep :
        = t('.openhub_edit_history')

  .project-edit-layout
    .project-edit-main
      = render partial: 'index'

    .project-edit-aside
      .about-account-basics-card
        .card-header
          .card-header-left
            .card-header-icon
              %i.fa.fa-history
            .card-header-text
              %h4.card-title= t('.openhub_edit_history')
              %p.card-subtitle= t('.page_title', name: @parent.name)
          %button.expand-toggle{ type: 'button', 'aria-label' => 'Toggle about section' }
            %i.fa.fa-chevron-down

        .card-content
          .tips-grid
            .tip-item
              .tip-icon
                %i.fa.fa-pencil
              .tip-body
                %p.tip-text= t('.help_1')
            .tip-item
              .tip-icon
                %i.fa.fa-undo
              .tip-body
                %p.tip-text= t('.help_2')
            .tip-item
              .tip-icon
                %i.fa.fa-info-circle
              .tip-body
                %p.tip-text= t('.help_3')

