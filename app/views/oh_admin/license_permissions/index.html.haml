%h1
  License Permissions

%section.content
  = render partial: 'layouts/partials/alert'

  - if @license_permissions.present?
    .row
      .col-lg-10
        .box
          .box-body.table-responsive.no-padding
            %table.table.table-striped.table-hover
              %thead
                %tr
                  %th Id
                  %th License
                  %th License Right
                  %th Status
                  %th Last Updated
                  %th.text-center Actions
              %tbody
                - @license_permissions.each do |license_permission|
                  - license = license_permission.license
                  %tr
                    %td
                      %strong= license_permission.id
                    %td= link_to license.name, "#", title: license.name
                    %td
                      %span.badge.badge-info= license_permission.name
                    %td
                      - if license_permission.status == 'Permitted'
                        %span.badge{style: 'background-color: #28a745; color: white;'}= license_permission.status
                      - elsif license_permission.status == 'Forbidden'
                        %span.badge{style: 'background-color: #dc3545; color: white;'}= license_permission.status
                      - elsif license_permission.status == 'Required'
                        %span.badge{style: 'background-color: #ffc107; color: #333;'}= license_permission.status
                      - else
                        %span.badge{style: 'background-color: #6c757d; color: white;'}= license_permission.status
                    %td
                      %small= license_permission.updated_at.strftime('%b %d, %Y')
                    %td.text-center
                      = link_to 'Edit', new_oh_admin_license_permission_path(license_id: license.id), class: 'license-edit-btn'
          .box-footer
            = render 'shared/modern_pagination', collection: @license_permissions
      .col-lg-2
        / Filter Card
        .box.filter-card
          .box-header.with-border.filter-header
            %i.fa.fa-filter
            %h3.box-title Filter
          .box-body
            = form_tag(oh_admin_license_permissions_path, method: 'get') do
              .filter-group
                %label License
                = select_tag 'license_id', options_for_select(@licenses, :selected => params[:license_id]), prompt: "All", class: 'filter-select'
              .filter-group
                %label License Right
                = select_tag 'license_right_id', options_for_select(@license_rights, :selected => params[:license_right_id]), prompt: "All", class: 'filter-select'
              .filter-group
                %label Status
                = select_tag 'status', options_for_select(LicensePermission.statuses, :selected => params[:status]), prompt: "All", class: 'filter-select'
              .filter-actions
                = submit_tag "Apply Filter", class: 'filter-btn filter-btn-apply'
                = submit_tag "Clear", name: 'commit', class: 'filter-btn filter-btn-clear'

        / Action Card
        .box.action-card
          .box-header.with-border.action-header
            %i.fa.fa-plus-circle
            %h3.box-title Quick Actions
          .box-body
            = link_to new_oh_admin_license_permission_path, class: 'action-btn btn-add' do
              %i.fa.fa-edit
              Add/Edit Permissions
  - else
    %h2= 'No License Permissions Found'
