%h1.lp-page-title
  %i.fa.fa-key
  License Permissions
  %span.lp-count-badge= @license_permissions.total_entries

%section.content
  = render partial: 'layouts/partials/alert'

  - if @license_permissions.present?
    .row
      .col-lg-9
        .box
          .box-body.table-responsive.no-padding
            %table.table.table-striped.table-hover
              %thead
                %tr
                  %th.col-id ID
                  %th License
                  %th License Right
                  %th Status
                  %th Last Updated
                  %th.text-center Actions
              %tbody
                - @license_permissions.each do |license_permission|
                  - license = license_permission.license
                  %tr
                    %td.lp-id-cell= license_permission.id
                    %td= link_to license.name, license_path(license), title: license.name, class: 'lp-license-name'
                    %td
                      %span.lp-right-tag= license_permission.name
                    %td
                      - status_key = license_permission.status.downcase
                      %span.lp-status-badge{ class: "lp-status-#{status_key}" }= license_permission.status
                    %td.lp-date-cell= license_permission.updated_at.strftime('%b %d, %Y')
                    %td.text-center
                      = link_to new_oh_admin_license_permission_path(license_id: license.id), class: 'license-edit-btn' do
                        %i.fa.fa-pencil
                        Edit
          .box-footer
            = render 'shared/modern_pagination', collection: @license_permissions
      .col-lg-3
        / Filter Card
        .box.filter-card
          .box-header.with-border.filter-header
            %i.fa.fa-filter
            %h3.box-title Filter
          .box-body
            = form_tag(oh_admin_license_permissions_path, method: 'get') do
              .filter-group
                %label License
                = select_tag 'license_id', options_for_select(@licenses, :selected => params[:license_id]), prompt: "All", class: 'filter-select'
              .filter-group
                %label License Right
                = select_tag 'license_right_id', options_for_select(@license_rights, :selected => params[:license_right_id]), prompt: "All", class: 'filter-select'
              .filter-group
                %label Status
                = select_tag 'status', options_for_select(LicensePermission.statuses, :selected => params[:status]), prompt: "All", class: 'filter-select'
              .filter-actions
                = submit_tag "Apply Filter", class: 'filter-btn filter-btn-apply'
                = link_to oh_admin_license_permissions_path, class: 'filter-btn filter-btn-clear' do
                  Clear Filter

        / Action Card
        .box.action-card
          .box-header.with-border.action-header
            %i.fa.fa-plus-circle
            %h3.box-title Quick Actions
          .box-body
            = link_to new_oh_admin_license_permission_path, class: 'action-btn btn-add' do
              %i.fa.fa-edit
              Add/Edit Permissions
  - else
    .lp-empty-state
      %i.fa.fa-key
      %h3 No License Permissions Found
      = link_to new_oh_admin_license_permission_path, class: 'lp-save-btn' do
        %i.fa.fa-plus
        Add Permissions
