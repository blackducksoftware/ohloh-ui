%h1.lp-page-title
  %i.fa.fa-key
  New License Permissions
%section.content
  = render partial: 'layouts/partials/alert'

  .box.lp-select-box
    .box-header.with-border.lp-select-header
      %i.fa.fa-search
      %h3.box-title Select License
    .box-body
      .lp-license-select-row
        = form_tag(new_oh_admin_license_permission_path, method: 'get', class: 'filter_form') do
          .filter-group
            = label_tag 'License', 'License'
            = select_tag 'license_id', options_for_select(@licenses, :selected => params[:license_id]),
                                      prompt: "Select License",
                                      onchange: 'this.form.submit()',
                                      class: 'filter-select'

  - if @permission_rights.present?
    .box.lp-permissions-box
      .box-header.with-border.lp-permissions-header
        %i.fa.fa-list-ul
        %h3.box-title Permission Rights
        %span.lp-rights-count= "#{@permission_rights.count} rights"
      .box-body
        = form_tag(oh_admin_license_permissions_path, method: 'post') do
          = hidden_field_tag 'license_id', params['license_id']
          .lp-rights-table
            .lp-rights-thead
              .lp-rights-tr
                .lp-rights-th.lp-col-name Right
                .lp-rights-th.lp-col-options Permitted
                .lp-rights-th.lp-col-options Forbidden
                .lp-rights-th.lp-col-options Required
            .lp-rights-tbody
              - @permission_rights.each_with_index do |permission_right, index|
                - element_name = "right_" + permission_right['id'].to_s
                - status = permission_right['status']
                .lp-rights-tr{ class: (index.even? ? 'lp-row-even' : 'lp-row-odd') }
                  .lp-rights-td.lp-col-name= permission_right['name']
                  .lp-rights-td.lp-col-options
                    .lp-radio-wrap
                      %input{ id: "permitted_#{permission_right['id']}", class: 'custom-radio',
                              checked: (status == '0'), name: element_name,
                              onclick: "ToggleSelection(this);", type: "checkbox", value: 0,
                              active: (status == '0' ? true : nil) }
                      %label.lp-radio-label.lp-radio-permitted{ for: "permitted_#{permission_right['id']}" }
                        %i.fa.fa-check
                  .lp-rights-td.lp-col-options
                    .lp-radio-wrap
                      %input{ id: "forbidden_#{permission_right['id']}", class: 'custom-radio',
                              checked: (status == '1'), name: element_name,
                              onclick: "ToggleSelection(this);", type: "checkbox", value: 1,
                              active: (status == '1' ? true : nil) }
                      %label.lp-radio-label.lp-radio-forbidden{ for: "forbidden_#{permission_right['id']}" }
                        %i.fa.fa-times
                  .lp-rights-td.lp-col-options
                    .lp-radio-wrap
                      %input{ id: "required_#{permission_right['id']}", class: 'custom-radio',
                              checked: (status == '2'), name: element_name,
                              onclick: "ToggleSelection(this);", type: "checkbox", value: 2,
                              active: (status == '2' ? true : nil) }
                      %label.lp-radio-label.lp-radio-required{ for: "required_#{permission_right['id']}" }
                        %i.fa.fa-exclamation

          .lp-save-row
            = submit_tag('Save Changes', class: 'lp-save-btn')
            = link_to 'Cancel', oh_admin_license_permissions_path, class: 'lp-cancel-btn'

  - else
    .lp-empty-state
      %i.fa.fa-hand-pointer-o
      %h2= params[:license_id].present? ? 'No Permission Rights Found' : 'No License Permissions Found'

:javascript
  function ToggleSelection(radio) {
    var elements = document.getElementsByName(radio.name);
    for (var i = 0, l = elements.length; i < l; i++) {
      if (elements[i] != radio) {
        elements[i].checked = false;
      }
    }
  }
