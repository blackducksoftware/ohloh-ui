:ruby
  content_for(:html_title) { t('.html_title', name: @project.name) }
  page_context[:select_footer_nav] = :commits
  analysis = @project.best_analysis

#commits-index-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-code-fork
      %h2.settings-page-h2
        = link_to t('.commits'), summary_project_commits_path(@project)
        = t('.listings')
    %p.settings-page-description= @project.name

  - if analysis.empty?
    = render 'projects/show/no_analysis_summary'
  - else
    = render 'commit', commits: @commits, search_dingus: true
