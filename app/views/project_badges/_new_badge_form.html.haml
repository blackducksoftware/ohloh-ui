= form_for @project_badge, url: project_project_badges_path(@project),
                           method: :post, html: { id: 'new_project_badge' } do |f|
  %td.pb-col-repo
    = f.select :enlistment_id, @enlistments, {}, id: 'select_project_repo', class: 'chzn-select', 'aria-label': t('project_badges.repo_url')
    - error_tag @project_badge, :enlistment_id
  %td.pb-col-type
    = f.select :type, @badges, { include_blank: true },
                      id: 'select_project_badge',
                      class: 'chzn-select badge_image_val selected_badge_val',
                      'aria-label': t('project_badges.badge_type')
    - error_tag @project_badge, :type
  %td.pb-col-url#badge_url_input_container
    = f.hidden_field :identifier, class: 'badge_url_field'
    - cii_badge_temp_class = 'hidden' unless @project_badge.type == 'CiiBadge'
    .cii_badge_url.badge_template.pb-url-display{ class: cii_badge_temp_class }
      %span.pb-url-prefix= ENV['CII_API_BASE_URL'] + 'projects'
      = text_field_tag('cii_url', @project_badge.identifier, class: 'badge_url_holder form-control', 'aria-label': t('project_badges.badge_url'))
      %span.pb-url-suffix /badge
    - travis_badge_temp_class = 'hidden' unless @project_badge.type == 'TravisBadge'
    .travis_badge_url.badge_template.pb-url-display{ class: travis_badge_temp_class }
      %span.pb-url-prefix= ENV['TRAVIS_API_BASE_URL']
      = text_field_tag('travis_url', @project_badge.identifier, class: 'badge_url_holder form-control', 'aria-label': t('project_badges.badge_url'))
    - error_tag(@project_badge, :identifier) unless @project_badge.errors[:type].present?
  %td.pb-col-image.badge_image_container
    = image_tag @project_badge.try(:badge_url), alt: '' if @project_badge.identifier
  %td.pb-col-actions
    %button.btn.btn-mini.btn-primary#save_badge{ type: 'button' }= t('project_badges.save_badge')
    &nbsp;
    %button.btn.btn-mini.btn-refresh#cancel_badge{ type: 'button' }= t('project_badges.cancel')
