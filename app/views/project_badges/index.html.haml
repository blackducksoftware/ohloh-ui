:ruby
  content_for(:html_title) { t('.page_title', name: @project.name) }

#project_badges_page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-trophy
      %h2.settings-page-h2
        = link_to t(:settings), settings_project_path(@project)
        %span.account-basics-sep :
        = t('.title')
      - btn_css = 'display: none;' unless @project_badge.errors.empty?
      %button.btn.btn-primary.pb-btn-new#add_badge_btn{ style: btn_css }
        %i.fa.fa-plus
        = t('.new_badge')
    %p.settings-page-description= t('.page_title', name: @project.name)

  .project-edit-layout
    .project-edit-main
      .pb-table-card
        = render 'editable_badges_table'
