- if @preferred_names.present?
  .alias-select-wrap
    = select_tag :preferred_name_id,
      options_for_select([[t('aliases.select_preferred_name'), '']] + @preferred_names.map { |n| [n.name, n.id] }),
      class: 'preferred value-select',
      data: { placeholder: t('aliases.select_preferred_name') }
- else
  .alias-select-wrap
    = select_tag :preferred_name_id,
      options_for_select([[t('aliases.no_preferred_names'), '']]),
      class: 'preferred value-select', disabled: true
