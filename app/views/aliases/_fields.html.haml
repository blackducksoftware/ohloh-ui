.alias-new-card-header
  %h3.alias-new-card-title
    %i.fa.fa-plus-circle
    = t('aliases.new_alias')

.alias-new-form
  .alias-field-group
    %label.alias-field-label{ for: 'commit_name_id' }= t('aliases.contributions_by')
    .alias-select-wrap
      = select_tag :commit_name_id,
        options_for_select([[t('aliases.select_committer'), '']] + @committer_names.map { |n| [n.name, n.id] }),
        class: 'chzn-select value-select',
        url: preferred_names_project_aliases_path(@project),
        data: { placeholder: t('aliases.select_committer') }

  .alias-field-group
    %label.alias-field-label{ for: 'preferred_name_id' }= t('aliases.attributed_to')
    .alias-select-wrap
      #preferred_name= render partial: 'preferred_names'

  %span.spinner= image_tag 'spinner.gif', alt: ''

  .alias-form-actions
    - if logged_in? && @project.edit_authorized?
      %button.btn.btn-primary.alias-submit-btn{ type: 'submit', id: 'submit_button' }
        %i.fa.fa-check
        = t('aliases.save_alias')
      = link_to t('cancel'), project_aliases_path(@project), class: 'btn btn-default btn-cancel-alias'
    - else
      = disabled_button t('aliases.save_alias'), class: 'btn-primary alias-submit-btn'
