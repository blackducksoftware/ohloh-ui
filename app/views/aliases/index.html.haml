:ruby
  content_for(:html_title) { t('.title', project_name: @project.name) }
  page_context[:select_footer_nav] = nil
  has_permission = logged_in? && @project.edit_authorized?

#alias-index-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-users
      %h2.settings-page-h2
        = link_to t('settings'), settings_project_path(@project)
        %span.account-basics-sep :
        = t('aliases.aliases')

  .project-edit-layout
    .project-edit-main
      .oh-card
        .alias-index-card-header
          %h3.alias-index-card-title
            %i.fa.fa-users
            = t('aliases.aliases')
          - if has_permission
            = link_to t('aliases.new_alias'), new_project_alias_path(@project), class: 'btn btn-primary btn-sm alias-add-btn'
          - else
            = disabled_button t('aliases.new_alias'), class: 'btn-primary btn-sm'

        - if @aliases.length + @best_analysis_aliases.length > 0
          .alias-list
            - @aliases.each do |a|
              .alias-list-item
                .alias-info
                  %span.alias-info-text
                    = t('aliases.contributions_by')
                    %strong= h(a.commit_name.name)
                  %span.alias-info-text
                    = t('aliases.attributed_to')
                    %strong= h(a.preferred_name.name)
                  - best_analysis_aliases = @best_analysis_aliases.pluck(:commit_name_id, :preferred_name_id)
                  - unless best_analysis_aliases.include?([a.commit_name_id, a.preferred_name_id])
                    %span.alias-badge.alias-badge--pending= t('.pending')
                .alias-item-actions
                  - if has_permission
                    %a.btn.btn-sm.btn-danger.alias-remove-btn{ href: undo_project_alias_path(project_id: @project.to_param, id: a.id),
                                                               data: { method: :post, confirm: t('.confirm_message') } }
                      %i.fa.fa-trash
                      = t('.remove')
                  - else
                    = disabled_button t('.remove'), class: 'btn-sm btn-danger'

            - @best_analysis_aliases.where.not(commit_name_id: @aliases.pluck(:commit_name_id)).each do |baa|
              .alias-list-item.alias-list-item--undone
                .alias-info
                  %span.alias-info-text
                    = t('aliases.contributions_by')
                    %strong= h(baa.commit_name.name)
                  %span.alias-info-text
                    = t('aliases.attributed_to')
                    %strong= h(baa.preferred_name.name)
                  %span.alias-badge.alias-badge--pending= t('.pending')
                .alias-item-actions
                  - if has_permission
                    %a.btn.btn-sm.btn-danger.alias-remove-btn{ href: redo_project_alias_path(project_id: @project.to_param, id: baa.id),
                                                               data: { method: :post, confirm: t('.confirm_message_redo') } }
                      %i.fa.fa-trash
                      = t('.remove')
                  - else
                    = disabled_button t('.remove'), class: 'btn-sm btn-danger'

        - else
          .alias-empty-state
            %i.fa.fa-folder-open-o.alias-empty-icon
            %p.alias-empty-text= t('.no_contributions')

    .project-edit-aside
      = render partial: 'about_aliases'
