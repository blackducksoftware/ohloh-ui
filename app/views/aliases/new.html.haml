:ruby
  content_for(:html_title) { t('.title', project_name: @project.name) }
  page_context[:select_footer_nav] = nil
  @alias ||= Alias.new
  @committer_names ||= Alias.committer_names(@project)

#alias-new-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-users
      %h2.settings-page-h2
        = link_to t('settings'), settings_project_path(@project)
        %span.account-basics-sep :
        = link_to t('aliases.aliases'), project_aliases_path(@project)
        %span.account-basics-sep :
        = t('aliases.new_alias')
    %p.settings-page-description= t('.title', project_name: @project.name)

  .project-edit-layout
    .project-edit-main
      - if @committer_names.length.zero?
        .alert.alert-info.modern-alert
          .alert-accent-strip
          .alert-inner
            = t('.no_more_alias')
      - else
        .oh-card
          = form_for [@project, @alias] do
            = render partial: 'fields'

    .project-edit-aside
      = render partial: 'about_aliases'
