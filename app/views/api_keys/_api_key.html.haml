- oauth_application = api_key.oauth_application || Doorkeeper::Application.new
- status_map = { ApiKey::STATUS_OK => ['ok', 'fa-check-circle', t('api_keys.status_active'), t('api_keys.can_be_used')], ApiKey::STATUS_LIMIT_EXCEEDED => ['limit-exceeded', 'fa-exclamation-triangle', t('api_keys.status_limit_exceeded'), t('api_keys.cant_use_now')], ApiKey::STATUS_DISABLED => ['disabled', 'fa-ban', t('api_keys.status_disabled'), t('api_keys.cant_use_ever')] }
- label_class, icon_class, status, status_appendix = status_map[api_key.status]

.edit-section.api-key-card
  .edit-section-header
    .edit-section-icon
      %i.fa.fa-key
    %h3.edit-section-title= oauth_application.name || t('api_keys.untitled_application')
    .api-key-status-badge{ class: "api-key-status-badge--#{label_class}" }
      %i.fa{ class: icon_class }
      = status
    .api-key-timestamp
      %i.fa.fa-clock-o
      = t 'api_keys.created_ago', ago: time_ago_in_words(api_key.created_at)
      - if api_key.last_access_at
        = " · #{t 'api_keys.last_accessed_at', ago: time_ago_in_words(api_key.last_access_at)}"
      - else
        = " · #{t 'api_keys.hasnt_been_used_yet'}"

  - if api_key.description.present?
    %p.api-key-description= api_key.description

  .api-key-body
    .api-key-details
      .api-key-detail-row
        %span.api-key-detail-label= t('.api_key')
        %code.api-key-detail-value{ title: oauth_application.uid }= oauth_application.uid

      .api-key-detail-row
        %span.api-key-detail-label= t('.oauth_secret')
        - secret = oauth_application.secret || t('.none')
        %code.api-key-detail-value{ title: secret }= secret

      - if oauth_application.redirect_uri.present?
        .api-key-detail-row
          %span.api-key-detail-label= t('.redirect_url')
          = link_to oauth_application.redirect_uri, target: '_blank', rel: 'noopener noreferrer', class: 'api-key-detail-link' do
            %i.fa.fa-external-link
            = oauth_application.redirect_uri

      - if api_key.url.present?
        .api-key-detail-row
          %span.api-key-detail-label= t('.home_page_url')
          = link_to h(api_key.url), target: '_blank', rel: 'noopener noreferrer', class: 'api-key-detail-link' do
            %i.fa.fa-external-link
            = h(api_key.url)

    .api-key-stats
      .api-key-stat
        %span.api-key-stat-value!= t('api_keys.requests_all_time_view', count: api_key.total_count.to_i)
      .api-key-stat
        %span.api-key-stat-value!= t('api_keys.requests_daily_view', count: api_key.daily_count.to_i)
      .api-key-stat
        %span.api-key-stat-value!= t('api_keys.requests_daily_limit_view', count: api_key.daily_limit.to_i)
      .api-key-stat-status
        %span.api-key-status-text{ class: "api-key-status-text--#{label_class}" }= status_appendix

  .api-key-footer
    = link_to edit_account_api_key_path(api_key.account, api_key), class: 'edit-save-btn edit-save-btn--sm' do
      %i.fa.fa-pencil
      = t 'api_keys.edit_api_key'

