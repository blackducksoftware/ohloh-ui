.topics-list
  - @recent_topics.each do |topic|
    .topic-row
      .topic-row-main
        .topic-row-title= link_to h(topic.title), topic_path(topic)
        .topic-row-meta
          - if topic.posts.last
            = t('.poster')
            = topic.posts.last.account.name
      .topic-row-stats
        .topic-row-stat
          %span.stat-value= topic.posts_count
          %span.stat-label= t('.posts')
      - if topic.replied_at
        .topic-row-last= t('.freshness_time', date: time_ago_in_words(topic.replied_at))
