- if topic.posts.present?
  .topic-row
    .topic-row-main
      .topic-row-title
        - if topic.sticky?
          %span.topic-row-badge.badge-new= t('.sticky')
        = link_to h(topic.title), topic_path(topic), class: 'entry-title', rel: 'bookmark'
      .topic-row-meta
        = t(:by)
        = topic.account.name
        - if topic.closed?
          %span.topic-row-badge.badge-closed= t('.closed')
        - elsif topic.created_at >= 30.minutes.ago
          %span.topic-row-badge.badge-new= t('.new')
        - elsif topic.posts.last.created_at >= 30.minutes.ago
          %span.topic-row-badge.badge-recent= t('.recent_post')
        - elsif topic.posts.last.created_at <= 6.months.ago
          %span.topic-row-badge.badge-stale= t('.stale')
    .topic-row-stats
      .topic-row-stat
        %span.stat-value= (topic.posts_count - 1)
        %span.stat-label= t('.replies')
      .topic-row-stat
        %span.stat-value= topic.hits
        %span.stat-label= t('.views')
    - last_post = topic.posts.last
    - if last_post
      .topic-row-last
        = time_ago_in_words(last_post.created_at)
        %br
        = t('.ago_by', name: last_post.account.name)
