.edit-field-group
  %label.edit-field-label{ for: 'manage_message' }= t('.message_label')
  = find_and_preserve(form.text_area(:message, rows: 8, max_length: 200, class: 'edit-field-textarea manager-textarea'))
  .manager-form-hints
    %p.edit-field-hint= t('.message_help1', target_type: @parent.class.to_s.downcase)
    %p.edit-field-hint= t('.message_help2')
  %p.manager-form-promise= t('.promise', target: html_escape(@parent.name), target_type: @parent.class)

.edit-form-actions
  %input.edit-save-btn{ type: 'submit', value: t('.submit') }
  = link_to t('cancel'), parent_managers_path(@parent), class: 'manager-cancel-btn'
