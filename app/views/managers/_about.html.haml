.about-account-basics-card
  .card-header
    .card-header-left
      .card-header-icon
        %i.fa.fa-info-circle
      .card-header-text
        %h4.card-title= t('.about') + ' ' + t(:managers_link_name)
        %p.card-subtitle= t('.powers_header', target_type: @parent.class)
    %button.expand-toggle{ type: 'button', 'aria-label' => 'Toggle about section' }
      %i.fa.fa-chevron-down

  .card-content
    .tips-grid
      .tip-item
        .tip-icon
          %i.fa.fa-pencil
        .tip-body
          %p.tip-text= t('.powers1')
      .tip-item
        .tip-icon
          %i.fa.fa-cog
        .tip-body
          %p.tip-text= t('.powers2', target_type: @parent.class.to_s.downcase)
      .tip-item
        .tip-icon
          %i.fa.fa-users
        .tip-body
          %p.tip-text= t('.powers3')
      .tip-item
        .tip-icon
          %i.fa.fa-book
        .tip-body
          %p.tip-text= t('.note', target_type: @parent.class.to_s.downcase)
      - if @parent.is_a?(Project)
        .tip-item
          .tip-icon
            %i.fa.fa-send
          .tip-body
            %p.tip-text= t('.application1')
        .tip-item
          .tip-icon
            %i.fa.fa-check-circle
          .tip-body
            %p.tip-text= t('.application2')
    .managers-learn-more
      = blog_link_to(link: :managing_projects, link_text: t(:learn_more))
