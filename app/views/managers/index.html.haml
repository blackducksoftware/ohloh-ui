- content_for(:html_title) { project_pages_title t('.page_title') }
- page_context[:select_footer_nav] = :settings

#managers-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-shield
      %h2.settings-page-h2
        = link_to t(:settings), settings_parent_path(@parent)
        %span.account-basics-sep :
        = t(:managers_link_name)
    %p.settings-page-description= t('.page_title')

  .project-edit-layout
    .project-edit-main

      / ── Managers list ──────────────────────────────────────
      .edit-section
        .edit-section-header
          .edit-section-icon
            %i.fa.fa-users
          %h3.edit-section-title= t(:managers_link_name)
          - if @parent.is_a?(Organization) && current_user_is_admin?
            %a.edit-save-btn.managers-add-btn{ href: new_parent_manager_path(@parent) }
              %i.fa.fa-plus
              = t('.new_manager')
          - if @parent.is_a?(Project) && !@parent.active_managers.include?(current_user)
            %a.edit-save-btn.managers-add-btn{ href: new_parent_manager_path(@parent) }
              %i.fa.fa-plus
              = t('.new_cta')

        - if @manages.any?
          .managers-list
            = render partial: 'manage', collection: @manages
        - else
          = render 'shared/alert', message: t('.nobody_manages_yet')

      -# ── Help card ────────────────────────────────────────
      - if @parent.is_a?(Project)
        - if !@parent.active_managers.include?(current_user)
          .edit-section.managers-help-section
            .edit-section-header
              .edit-section-icon.edit-section-icon--amber
                %i.fa.fa-info-circle
              %h3.edit-section-title= t('.help_header_first1')
            %p.managers-help-text= t('.help_body_first1')
            %h3.managers-help-subhead= t('.help_header_first2')
            %p.managers-help-text= t('.help_body_first2')
        - elsif !@parent.manages.pending.blank?
          .edit-section.managers-help-section
            .edit-section-header
              .edit-section-icon.edit-section-icon--amber
                %i.fa.fa-clock-o
              %h3.edit-section-title= t('.help_header_existing', target: html_escape(@parent.name))
            %p.managers-help-text= t('.help_body_existing1')
            %p.managers-help-text= t('.help_body_existing2')
            %p.managers-help-text= t('.help_body_existing3')

    / ── About ──────────────────────────────────────────────
    .project-edit-aside
      = render partial: 'about'
