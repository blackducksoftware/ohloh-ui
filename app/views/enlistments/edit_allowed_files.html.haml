- content_for(:html_title) { t('.html_title', name: @project.name) }
- page_context[:select_footer_nav] = nil

#enlistment-edit-page
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-check-square-o
      %h2.settings-page-h2
        = link_to t('settings'), settings_project_path(@project)
        %span.account-basics-sep :
        = link_to t('.code_locations'), project_enlistments_path(@project)
        %span.account-basics-sep :
        = t('.allow_files_title')
    %p.settings-page-description= t('.page_description')
  .oh-card
    = form_for [@project, @enlistment], html: { method: :put } do |f|
      .enl-form-row
        %label.enl-label{ for: 'enlistment_allowed_fyles' }
          = t('.allowed_files_for')
          %strong.code-location-url= @enlistment.code_location.nice_url
        = find_and_preserve(f.text_area(:allowed_fyles, rows: 20, class: 'form-control enl-textarea'))
        - error_tag @enlistment, :allowed_fyles
        .enl-hint= t('.description1')
      .enl-form-actions
        = f.submit t('.save_allowed_files'), class: 'edit-save-btn'
.clearfix

.about-account-basics-card{ style: 'max-width: none; margin: 24px 0 0; padding: 0;' }
  .card-header
    .card-header-left
      .card-header-icon
        %i.fa.fa-info-circle
      .card-header-text
        %h4.card-title= t('.about_allow_title')
  .enl-about-ignore-grid
    .enl-about-ignore-example
      %p.enl-about-section-label= t('.example')
      - other_examples = ''
      - if @examples.present?
        - other_examples << t('.some_random_files')
        - @examples.each do |enlistment|
          - other_examples << t('.allow_html', enlistment: enlistment)
      %pre.enl-example-pre
        = t('.included_directory_html', other_examples: other_examples)

