.enl-form-layout
  .enl-form-main
    .enl-form-row
      %label.enl-label.required{ for: 'repository_type' }= t('.scm_type')
      .chosen#value_select
        %select.chzn-select.value-select{ name: 'code_location[scm_type]', id: 'repository_type' }
          = options_for_select_type(@code_location.scm_type)
      - error_tag @code_location, :scm_type

    .enl-form-row
      .default-url-tags
        %label.enl-label.required{ for: 'code_location_url' }= t('.enter_url')
        = f.text_field :url, class: 'form-control', value: params.dig(:code_location, :url)
        - error_tag @code_location, :url

      .github.scm_info{ style: 'display: none;' }
        %label.enl-label.required{ for: 'code_location_github_url' }= t('.enter_github_username')
        .input-group
          %span.input-group-addon https://github.com/
          = f.text_field :url, class: 'form-control', id: 'code_location_github_url'
        - error_tag @code_location, :url

    .svn.cvs.scm_info.enl-credentials{ style: 'display: none;' }
      .enl-credentials-header
        %i.fa.fa-lock
        %span= t('.if_required')
      .enl-form-row
        %label.enl-label.sr-only{ for: 'code_location_username' }= t('.username')
        = f.text_field :username, placeholder: t('.username'), class: 'form-control'
        - error_tag @code_location, :username
      .enl-form-row
        %label.enl-label.sr-only{ for: 'code_location_password' }= t('.password')
        = f.text_field :password, placeholder: t('.password'), class: 'form-control'
        - error_tag @code_location, :password
      .enl-warning
        %i.fa.fa-exclamation-triangle
        %strong= t('.warning')
        = t('.description23')

    .cvs.scm_info{ style: 'display: none;' }
      .enl-form-row
        %label.enl-label.required{ for: 'code_location_cvs_branch' }= t('.cvs_module_name')
        = f.text_field :branch, class: 'form-control', id: 'code_location_cvs_branch'
        - error_tag @code_location, :branch
        .enl-hint
          = t('.enter_cvs')
          %br
          = t('.create_seperate_enlistment')

    .git.scm_info{ style: 'display: none;' }
      .enl-form-row
        %label.enl-label.required{ for: 'code_location_git_branch' }= t('.enter_git')
        = f.text_field :branch, class: 'form-control', id: 'code_location_git_branch', value: params.dig(:code_location, :branch)
        - error_tag @code_location, :branch_name
        .enl-hint= t('.enter_git_name')

    .github.scm_info{ style: 'display: none;' }
      .enl-hint= t('.github_username_info')

    - error_tag @code_location, :failed

    .enl-form-actions
      - if logged_in? && @project.edit_authorized?
        = submit_tag t('.save_code_location'), class: 'edit-save-btn submit'
        %p.spinner{ style: 'display: none;' }
          = image_tag 'spinner.gif', alt: ''
          = t('.check_server_connection')
      - else
        = disabled_button t('.save_code_location'), class: 'edit-save-btn'

  .enl-form-sidebar
    .enl-sidebar-static
      .enl-sidebar-icon
        %i.fa.fa-code-fork
      %p.enl-sidebar-intro= t('.sidebar_intro')

    .cvs.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.description4')
        %li= t('.description5')
    .svn.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.description6')
        %li= t('.description7')
      .enl-hint!= t('.description8_html')
    .git.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.description15')
        %li= t('.description16')
    .hg.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.description17')
        %li= t('.description18')
    .bzr.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.description19')
        %li= t('.description20')
    .github.scm_info.enl-examples{ style: 'display: none;' }
      %p.enl-examples-title= t('.example')
      %ul.enl-examples-list
        %li= t('.github_username_example')
