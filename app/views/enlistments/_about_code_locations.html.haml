.about-account-basics-card
  .card-header
    .card-header-left
      .card-header-icon
        %i.fa.fa-code-fork
      .card-header-text
        %h4.card-title= t('.about') + ' ' + t('.code_locations')
        %p.card-subtitle= t('.code_locations')
    %button.expand-toggle{ type: 'button', 'aria-label' => 'Toggle about section' }
      %i.fa.fa-chevron-down

  .card-content
    .tips-grid
      .tip-item
        .tip-icon
          %i.fa.fa-git
        .tip-body
          %p.tip-text= t('.tip_vcs')
      .tip-item
        .tip-icon
          %i.fa.fa-clock-o
        .tip-body
          %p.tip-text= t('.tip_queue')
      .tip-item
        .tip-icon
          %i.fa.fa-lock
        .tip-body
          %p.tip-text= t('.tip_credentials')
      .tip-item
        .tip-icon
          %i.fa.fa-sitemap
        .tip-body
          %p.tip-text= t('.tip_multi')
