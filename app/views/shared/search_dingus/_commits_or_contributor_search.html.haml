- total_count ||= 0

.search-filter-bar
  %form
    .search-filter-content
      .search-section
        %label{for: 'query'}= t('shared.search_dingus.search_bar.search_text')
        .search-input-wrapper
          %input#query{type: 'text', name: 'query', placeholder: t('shared.search_dingus.search_bar.search_text'), value: params[:query]}
          %button.search-cancel-btn{ type: 'button', 'aria-label': t('shared.search_dingus.search_bar.clear_search'), style: (params[:query].blank? ? 'display: none;' : '') }
            %i.fa.fa-times
        %button.search-refresh-btn{ type: 'submit', 'aria-label': t('shared.search_dingus.search_bar.search') }
          %i.fa.fa-refresh

      - if type == :contributions
        = render 'shared/search_dingus/sort', sort_context: :contributions, filter_type: nil

      - if type == :commits
        .sort-section
          %label= t('shared.search_dingus.sort.sort_by')
          - current_span = params[:time_span] || '30 days'
          .custom-sort-dropdown
            %button.sort-dropdown-btn{ type: 'button' }
              %span.selection{ data: { value: current_span } }= current_span
              %i.fa.fa-chevron-down
            .dropdown-menu.sort-dropdown-menu
              - TIME_SPANS.each_key do |label|
                %button.sort-dropdown-item{ type: 'button', data: { value: label }, class: (label == current_span ? 'active' : '') }= label
          %input{ type: 'hidden', name: 'time_span', value: current_span, class: 'sort-value-input' }

      - if type == :commits && @project.best_analysis.oldest_code_set_time.present?
        %span.commits_display_date_range
          %i.icon-time
          - if TIME_SPANS[params[:time_span]] == :last_30_days
            = (@project.best_analysis.oldest_code_set_time - 30.days).to_s(:mdy)
          - else
            = (@project.best_analysis.oldest_code_set_time - 12.months).to_s(:mdy)
          &mdash;
          = @project.best_analysis.oldest_code_set_time.to_s(:mdy)
