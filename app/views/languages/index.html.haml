- content_for(:html_title) { t('.title') }

.languages-index-container
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-code
      %h2.settings-page-h2
        = t('.heading')

  = render 'shared/search_dingus', collection: @languages, sort_context: 'languages', no_match_found_type: :flash
  = render partial: 'language', collection: @languages

  = render 'shared/modern_pagination', collection: @languages
