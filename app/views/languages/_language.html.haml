- show_lang_usage ||= false

.oh-card.lang-stats-card
  .lang-stats-header
    %h2.lang-stats-title
      = link_to language.nice_name, language_path(language)
    - if show_lang_usage
      .lang-stats-earliest
        %span.lang-stats-earliest-label= t('.earliest_usage')
        - if @language_facts.present?
          %span.lang-stats-earliest-value= @language_facts.first.month.strftime('%B %Y')
        - else
          %span.lang-stats-earliest-value= t('.unknown')

  .lang-stats-grid
    .lang-stats-code-block
      .lang-stat-item
        %span.lang-stat-label= t('.total_lines')
        %span.lang-stat-value= number_with_delimiter(language.code.to_i + language.comments.to_i + language.blanks.to_i)
      .lang-stat-item
        %span.lang-stat-label= t('.code')
        %span.lang-stat-value= number_with_delimiter(language.code)
      .lang-stat-item
        %span.lang-stat-label= t('.comments')
        %span.lang-stat-value
          = number_with_delimiter(language.comments)
          %span.lang-stat-pct= t('.precision_percentage', precision: number_with_precision((language.avg_percent_comments || 0) * 100.0, precision: 1))

    .lang-stats-metrics
      .lang-metric-card
        %span.lang-metric-label= t('.projects')
        %span.lang-metric-value= number_with_delimiter(language.projects)
        = render 'mini_chart', language: language, measure: 'projects'

      .lang-metric-card
        %span.lang-metric-label= t('.contributors')
        %span.lang-metric-value= number_with_delimiter(language.contributors)
        = render 'mini_chart', language: language, measure: 'contributors'

      .lang-metric-card
        %span.lang-metric-label= t('.commits')
        %span.lang-metric-value= number_with_delimiter(language.commits)
        = render 'mini_chart', language: language, measure: 'commits'
