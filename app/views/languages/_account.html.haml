.lang-contributors-list
  - accounts.each_with_index do |account_id, i|
    - account_array = @accounts_map[account_id.first]
    - if account_array
      - account = account_array.first
      .lang-contributor-row
        .lang-contributor-rank= avatar_small_laurels(account.kudo_rank)
        .lang-contributor-avatar
          = link_to account_path(account) do
            = avatar_img_for(account, 32)
        .lang-contributor-info
          %a.lang-contributor-name{ href: account_path(account) }
            #{i + 1}. #{account.name}
          - if show_commits
            %span.lang-contributor-metric= pluralize(account_id.last, 'commit')
          - else
            %span.lang-contributor-metric= months_or_years(account_id.last.to_i)
