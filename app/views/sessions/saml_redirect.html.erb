<div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); display:flex; justify-content:center; align-items:center; z-index:9999;">
  <div style="background:#1a1a1a; border:1px solid #444; border-radius:8px; padding:48px 40px; text-align:center; max-width:420px; width:100%; color:#fff;">
    <h3 style="color:#fff; margin-bottom:12px;">Single sign-on to <strong>Open Hub</strong></h3>
    <p style="color:#aaa; margin-bottom:28px;">Authenticate your account by logging into Black Duck's single sign-on provider.</p>

    <%= form_with url: '/auth/saml', method: :post, local: true, id: 'saml-redirect-form' do |f| %>
      <%= f.hidden_field :RelayState, value: @relay_state %>
      <%= f.submit 'Continue', class: 'btn btn-primary btn-block', style: 'width:100%; padding:10px;' %>
    <% end %>
  </div>
</div>
