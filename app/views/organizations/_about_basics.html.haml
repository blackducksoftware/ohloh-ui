.tips-grid
  .tip-item
    .tip-icon
      %i.fa.fa-tag
    .tip-body
      %p.tip-text
        = t('.info')
        %a{ href: 'https://community.blackduck.com/s/article/Black-Duck-Open-Hub-Support', target: '_blank', rel: 'noopener noreferrer' }= t('.contact_us')
        = t('.inapropriate')

  .tip-item
    .tip-icon
      %i.fa.fa-link
    .tip-body
      %p.tip-text= t('.url_unique')

  .tip-item
    .tip-icon
      %i.fa.fa-align-left
    .tip-body
      %p.tip-text= t('.description')
