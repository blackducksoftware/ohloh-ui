- content_for(:html_title) { t('.page_title') }
- page_context[:select_top_menu_nav] = 'select_organizations'

.org-settings-wrap
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-building
      %h2.settings-page-h2= t('.title')
    %p.settings-page-description= t('.page_title')

  #account-edit-form
    = form_for @organization, url: organizations_path do |f|
      = render partial: 'fields', locals: { f: f }

  .about-account-basics-card
    .card-header
      .card-header-left
        .card-header-icon
          %i.fa.fa-info-circle
        .card-header-text
          %h4.card-title= t('about')
          %p.card-subtitle= t('organizations.new.title')
      %button.expand-toggle{ type: 'button', 'aria-label' => 'Expand about section' }
        %i.fa.fa-chevron-down
    .card-content
      = render partial: 'about_basics'
