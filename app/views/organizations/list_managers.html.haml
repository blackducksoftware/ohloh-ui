:ruby
  page_context[:select_top_menu_nav] = 'select_organizations'
  page_context[:select_footer_nav] = nil
  content_for(:html_title) { t('.page_title', name: @organization.name) }

.org-settings-wrap
  .settings-page-header
    .settings-page-header-row
      .settings-page-icon
        %i.fa.fa-user-md
      %h2.settings-page-h2
        = link_to t('.title_link'), settings_organization_path(@organization)
        %span.account-basics-sep :
        = t('.title').delete(':').strip
      - if logged_in? && @organization.edit_authorized?
        = link_to new_manager_organization_path(@organization), class: 'edit-save-btn stacks-new-btn' do
          %i.fa.fa-plus
          = t('.new_manager')

  - if @managers.empty?
    .managers-empty-state
      .managers-empty-icon
        %i.fa.fa-users
      %p.managers-empty-text= t('.empty_alert')
      - if logged_in? && @organization.edit_authorized?
        = link_to new_manager_organization_path(@organization), class: 'edit-save-btn' do
          %i.fa.fa-plus
          = t('.new_manager')
  - else
    .managers-list
      - @managers.each do |manager|
        .manager-card
          .manager-avatar
            = avatar_for(manager.person, size: 48)
          .manager-info
            %a.manager-name{ href: account_url(manager) }= h(manager.name)
          .manager-actions
            - if logged_in? && @organization.edit_authorized?
              - link_values = manager_link(manager, @organization)
              = link_to link_values[:path], link_values[:options].merge(class: 'manager-remove-btn') do
                %i.fa.fa-trash
                = t('.remove').titleize
            - else
              = link_to '#', class: "manager-remove-btn disabled #{logged_in? ? '' : 'needs_login'}" do
                %i.fa.fa-trash
                = t('.remove').titleize

  .about-account-basics-card
    .card-header
      .card-header-left
        .card-header-icon
          %i.fa.fa-info-circle
        .card-header-text
          %h4.card-title= t('about')
          %p.card-subtitle Managers
      %button.expand-toggle{ type: 'button', 'aria-label' => 'Expand about section' }
        %i.fa.fa-chevron-down
    .card-content
      = render partial: 'about_managers'

