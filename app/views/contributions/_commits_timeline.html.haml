- fact = @contribution.contributor_fact
.oh-card.contribution-timeline-card
  %h4.contribution-timeline__title= t('.project_commits')
  - if fact.commits.to_i > 0
    - fact_format = fact.last_checkin.strftime('%b %d %Y %H:%M:%S %Z')
    #timeline{ project_id: contribution.project_id.to_s, name_id: fact.name_id.to_s, date: fact_format }
    %p.contribution-timeline__approx= t('.approximately')
  - else
    %p.contribution-timeline__empty= t('.no_commits')
